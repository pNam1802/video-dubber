# development | production. production bat buoc phai co FLASK_SECRET_KEY.
APP_ENV=development
# Tao key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Mac dinh bat theo APP_ENV; chi tat khi chay production sau HTTP noi bo.
SESSION_COOKIE_SECURE=
SESSION_LIFETIME_DAYS=7
MAX_UPLOAD_MB=2048
# De trong = SQLite o data/database.db (chi dung cho dev).
# Production: postgresql://user:pass@host/db  (Neon, Supabase...)
DATABASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MARIAN_MODEL_EN_VI=Helsinki-NLP/opus-mt-en-vi
# Dang nhap bang Google (de trong = tat).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email thong bao job (can duyet/xong/loi) — de trong ca hai la tat, khong
# loi gi. Vi du Gmail: bat 2 lop, tao App Password tai
# https://myaccount.google.com/apppasswords, dung gia tri do lam SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Domain that de dung link bam thang toi job trong email, vd
# https://pnam1802--video-dubber-web.modal.run — de trong van gui duoc,
# chi thieu link.
APP_BASE_URL=
# Backend Whisper: auto | faster | openai
WHISPER_BACKEND=auto
# So segment TTS chay song song (mac dinh 8).
TTS_CONCURRENCY=8
# Han muc moi user thuong trong 24 gio (admin khong bi gioi han).
QUOTA_JOBS_PER_DAY=10
QUOTA_GPU_SECONDS_PER_DAY=1800
QUOTA_STORAGE_MB=2048
# Don gia GPU de uoc tinh chi phi (mac dinh T4 tren Modal).
GPU_COST_PER_SECOND=0.000164
# Timeout (giay) cho lenh ngoai va so lan thu lai cua API dich.
FFMPEG_TIMEOUT=1800
FFPROBE_TIMEOUT=60
LLM_MAX_RETRIES=4
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
